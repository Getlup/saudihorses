# انسخ هذا الملف إلى .env محليًا ولا ترفعه أبدًا إلى GitHub (موجود في .gitignore)

# مفتاح سرّي عشوائي طويل — أنشئه بأمر: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# development تُظهر تفاصيل الأخطاء وتسمح بعمل التطبيق بدون SECRET_KEY (لا تستخدمها في الإنتاج)
FLASK_ENV=development

# اتركه فارغًا محليًا لاستخدام SQLite تلقائيًا، أو ضع رابط PostgreSQL في الإنتاج:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# اختياري: تخزين حدود معدل الطلبات (افتراضيًا في الذاكرة — استخدم Redis في إنتاج متعدد الخوادم)
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# بوابة الدفع الحالية محاكاة فقط (لا تحصّل مبالغ حقيقية). اضبطها false بمجرد ربط
# بوابة دفع حقيقية (Moyasar/HyperPay)، حتى لا يُترك الدفع الوهمي يؤكد حجوزات حقيقية.
SIMULATED_PAYMENTS_ENABLED=true
